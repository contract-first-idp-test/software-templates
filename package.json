{
  "name": "contract-first-idp-software-templates",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "npm run test:contracts && npm run test:skeletons",
    "test:contracts": "jest test/contracts --runInBand",
    "test:skeletons": "jest test/skeletons --runInBand",
    "test:chart-compat": "node test/contracts/chart-compat.js",
    "test:build": "node test/build/verify-component-profiles.js",
    "test:smoke": "node test/smoke/run.js",
    "test:apicurio-live": "node test/live/apicurio.js",
    "test:promotion-live": "./test/live/promotion.sh",
    "test:debug": "cross-env DRY_RUN_WRITE_OUTPUT=1 node test/smoke/run.js",
    "clean": "rimraf output"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^5.2.5",
    "fs-extra": "^11.2.3",
    "jest": "^29.7.0",
    "jsonata": "^2.1.0",
    "nunjucks": "^3.2.4",
    "recursive-readdir": "^2.2.3",
    "rimraf": "^6.1.3",
    "yaml": "^2.5.1"
  }
}
